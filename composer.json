{
    "name": "chkltlabs/plaid-sdk-php",
    "description": "PHP implementation of Plaid's API as an SDK.",
    "keywords": [
        "plaid",
        "sdk",
        "php"
    ],
    "type": "library",
    "homepage": "https://github.com/chkltlabs/plaid-sdk-php",
    "support": {
        "issues": "https://github.com/chkltlabs/plaid-sdk-php/issues",
        "source": "https://github.com/chkltlabs/plaid-sdk-php"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-curl": "*",
        "nimbly/shuttle": "^2.0",
        "psr/http-client": "^1.0",
        "psr/http-message": "^2.0",
        "psr/http-factory": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "ChkltLabs\\Plaid\\" : "src"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "vimeo/psalm": "^6.0",
        "symfony/var-dumper": "^5.0|^6.0|^7.0"
    },
    "autoload-dev": {
        "psr-4": {
            "ChkltLabs\\Plaid\\Tests\\": "tests"
        }
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Brent Scheffler",
            "email": "brent@brentscheffler.com"
        }
    ],
    "config": {
        "platform": {
            "php": "8.2.27"
        },
        "sort-packages": true
    }
}
